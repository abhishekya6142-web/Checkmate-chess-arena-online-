// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: userId (UID)
// Fields:
//   - uid: string (required) - User's unique ID
//   - displayName: string (optional) - User's display name
//   - photoURL: string (optional) - User's photo URL
//   - email: string (optional) - User's email
//
// Collection: games
// Document ID: gameId
// Fields:
//   - fen: string (required) - Current board state
//   - history: list (required) - List of moves in SAN
//   - players: map (required) - { w: uid, b: uid }
//   - status: string (required) - 'waiting', 'active', 'finished'
//   - turn: string (required) - 'w', 'b'
//   - winner: string (optional) - UID or 'draw'
//   - lastMoveAt: timestamp (optional) - Time of last move
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    // Custom anonymous system helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128; 
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 100));
    }

    function isValidGame(data) {
      return data.keys().hasAll(['fen', 'status', 'turn']) &&
             data.fen is string && data.fen.size() < 200 &&
             data.status in ['waiting', 'active', 'finished'] &&
             data.turn in ['w', 'b'] &&
             (!('history' in data) || (data.history is list && data.history.size() < 1000)) &&
             (!('players' in data) || (data.players is map && data.players.keys().hasOnly(['w', 'b']))) &&
             (!('winner' in data) || (data.winner is string || data.winner == null)) &&
             (!('lastMoveAt' in data) || (data.lastMoveAt is timestamp));
    }

    match /games/{gameId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidGame(request.resource.data);
      allow update: if isValidGame(request.resource.data);
      allow delete: if false;
    }
  }
}
